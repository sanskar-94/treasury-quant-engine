# ---- Data providers (optional; public endpoints work without keys) ----
FRED_API_KEY=
TQE_DATA_DIR=data

# ---- Execution ----
# Broker: paper | alpaca
TQE_BROKER=paper
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Risk limits (hard stops enforced by the pre-trade risk gate) ----
TQE_MAX_GROSS_DV01=25000
TQE_MAX_NET_DV01=15000
TQE_MAX_ORDER_NOTIONAL=2000000
TQE_MAX_DAILY_LOSS_PCT=0.03
TQE_KILL_SWITCH=0
